-- Fling All
local function FlingAll()
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
    
    local RootPart = LocalPlayer.Character.HumanoidRootPart
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local targetRoot = player.Character.HumanoidRootPart
            
            local tween = TweenService:Create(RootPart, TweenInfo.new(0.1, Enum.EasingStyle.Linear), {
                CFrame = targetRoot.CFrame * CFrame.new(0, 2, 0)
            })
            tween:Play()
            task.wait(0.1)
            
            RootPart.Velocity = Vector3.new(0, 10000, 0)
            RootPart.RotVelocity = Vector3.new(math.random(-5000, 5000), math.random(-5000, 5000), math.random(-5000, 5000))
            
            targetRoot.Velocity = Vector3.new(math.random(-500, 500), 5000, math.random(-500, 500))
            targetRoot.RotVelocity = Vector3.new(math.random(-3000, 3000), math.random(-3000, 3000), math.random(-3000, 3000))
        end
    end
end

