    local BillboardGui = Instance.new("BillboardGui")
    local TextLabel = Instance.new("TextLabel")
    local Box = Instance.new("BoxHandleAdornment")
    local Tracer = Instance.new("Beam")
    
    BillboardGui.Adornee = Character.Head
    BillboardGui.Name = "AAL_ESP"
    BillboardGui.Size = UDim2.new(0, 100, 0, 50)
    BillboardGui.StudsOffset = Vector3.new(0, 2.5, 0)
    BillboardGui.AlwaysOnTop = true
    
    TextLabel.Text = Player.Name .. "\n❤️ " .. math.floor(Character.Humanoid.Health) .. " | " .. math.floor(Character.HumanoidRootPart.Position.Magnitude) .. "m"
    TextLabel.Size = UDim2.new(1, 0, 1, 0)
    TextLabel.BackgroundTransparency = 1
    TextLabel.TextColor3 = Settings.Visuals.TextColor
    TextLabel.TextStrokeTransparency = 0
    TextLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    TextLabel.Font = Enum.Font.GothamBold
    TextLabel.TextSize = 14
    TextLabel.Parent = BillboardGui
    
    Box.Adornee = Character.HumanoidRootPart
    Box.Name = "AAL_Box"
    Box.Size = Vector3.new(2, 4, 1)
    Box.Color3 = Settings.Visuals.BoxColor
    Box.Thickness = Settings.Visuals.BoxThickness
    Box.AdornCullingMode = Enum.AdornCullingMode.Automatic
    Box.AlwaysOnTop = true
    Box.ZIndex = 5
    Box.Transparency = 0.3
    Box.Parent = Character.HumanoidRootPart
    
    BillboardGui.Parent = Character.Head
    
    table.insert(ESPConnections, {Gui = BillboardGui, Box = Box, Player = Player})
end

local function ESPLoop()
    for _, v in pairs(Players:GetPlayers()) do
        if v ~= LocalPlayer then
            local hasESP = false
            for _, esp in pairs(ESPConnections) do
                if esp.Player == v then hasESP = true break end
            end
            if not hasESP then
                CreateESP(v)
            end
        end
    end
    
    for _, esp in pairs(ESPConnections) do
        if esp.Player.Character and esp.Player.Character:FindFirstChild("HumanoidRootPart") then
            local Pos = esp.Player.Character.HumanoidRootPart.Position
            local _, OnScreen = Camera:WorldToViewportPoint(Pos)
            if esp.Gui then esp.Gui.Enabled = OnScreen end
            if esp.Box then esp.Box.Visible = OnScreen end
        end
    end
end

-- Aimbot
local function AimbotLoop()
    if not Settings.AimbotEnabled or not LocalPlayer.Character then return end
    
    local closestPlayer = nil
    local closestDistance = Settings.FOV
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local head = player.Character.Head
            local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
            if onScreen then
                local mousePos = UserInputService:GetMouseLocation()
                local distance = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                if distance < closestDistance then
                    closestDistance = distance
                    closestPlayer = player
                end
            end
        end
    end
    
    if closestPlayer and closestPlayer.Character and closestPlayer.Character:FindFirstChild("Head") then
        local targetPos = closestPlayer.Character.Head.Position
        local currentPos = Camera.CFrame.Position
        local newCFrame = CFrame.lookAt(currentPos, targetPos)
        Camera.CFrame = Camera.CFrame:Lerp(newCFrame, Settings.AimbotSmooth / 10)
    end
end

